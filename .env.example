# GitHub API
# Optional but recommended. Unauthenticated GitHub API requests have a much lower rate limit.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# OpenAI API
# Required for OpenAI embedding topic discovery and LLM topic labeling.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# SQLite database
# Relative paths are resolved from the project root by src/utils/config.py.
DATABASE_PATH=database/product_research.db
